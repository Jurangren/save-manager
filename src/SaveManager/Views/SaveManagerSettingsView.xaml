<UserControl x:Class="SaveManager.Views.SaveManagerSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="500">
    <UserControl.Resources>
        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextBlockStyle}" />
    </UserControl.Resources>
    
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="20">
        <TextBlock Text="{DynamicResource LOCSaveManagerSettingsTitle}" FontSize="18" FontWeight="Bold" Margin="0,0,0,20"/>

        <TextBlock Text="{DynamicResource LOCSaveManagerBackupStorage}" FontSize="14" FontWeight="SemiBold"/>
        <Grid Margin="0,8,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox Grid.Column="0" Text="{Binding CustomBackupPath}" IsReadOnly="True"
                     ToolTip="{DynamicResource LOCSaveManagerCustomBackupPathTooltip}"/>
            <Button Grid.Column="1" Command="{Binding BrowseBackupPathCommand}" Margin="8,0,0,0" Padding="10,5">
                <TextBlock Text="{DynamicResource LOCSaveManagerBrowse}"/>
            </Button>
            <Button Grid.Column="2" Command="{Binding ClearBackupPathCommand}" Margin="8,0,0,0" Padding="10,5">
                <TextBlock Text="{DynamicResource LOCSaveManagerUseDefaultBackupPath}"/>
            </Button>
        </Grid>
        
        <CheckBox Content="{DynamicResource LOCSaveManagerAutoBackup}"
                  IsChecked="{Binding AutoBackupOnGameExit}" 
                  Margin="0,10,0,0"/>
        
        
        <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
            <TextBlock Text="{DynamicResource LOCSaveManagerMaxAutoBackupCount}" VerticalAlignment="Center"/>
            <TextBox Text="{Binding MaxAutoBackupCount}" Width="60" Margin="10,0" 
                     ToolTip="{DynamicResource LOCSaveManagerMaxAutoBackupCountTooltip}"/>
            <TextBlock Text="{DynamicResource LOCSaveManagerMaxAutoBackupCountHint}" VerticalAlignment="Center" Opacity="0.6"/>
        </StackPanel>

        <CheckBox Content="{DynamicResource LOCSaveManagerSettingShowAutoBackupNotification}" 
                  IsChecked="{Binding ShowAutoBackupNotification}" 
                  Margin="0,10,0,0"/>
        
        <TextBlock Text="{DynamicResource LOCSaveManagerZipWarning}" 
                   Opacity="0.6" Margin="0,30,0,0" FontStyle="Italic"/>
        
        <!-- 分隔线 -->
        <Separator Margin="0,30,0,15" Background="{DynamicResource NormalBorderBrush}"/>
        
        <!-- 数据管理区域 -->
        <TextBlock Text="{DynamicResource LOCSaveManagerDataManagement}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
        
        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
            <Button Command="{Binding GlobalExportCommand}" 
                    ToolTip="{DynamicResource LOCSaveManagerGlobalExportTooltip}"
                    Padding="10,6" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📤" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource LOCSaveManagerGlobalExport}"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding GlobalImportCommand}" 
                    ToolTip="{DynamicResource LOCSaveManagerGlobalImportTooltip}"
                    Padding="10,6" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📥" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource LOCSaveManagerGlobalImport}"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding OpenDataFolderCommand}" 
                    ToolTip="{DynamicResource LOCSaveManagerOpenDataFolderTooltip}"
                    Padding="10,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📁" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource LOCSaveManagerOpenDataFolder}"/>
                </StackPanel>
            </Button>
        </StackPanel>
        
        <!-- 跨设备管理区域 -->
        <Separator Margin="0,20,0,15" Background="{DynamicResource NormalBorderBrush}"/>
        
        <TextBlock Text="{DynamicResource LOCSaveManagerCrossDeviceManagement}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
        
        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
            <Button Command="{Binding OpenGameMatchingCommand}" 
                    ToolTip="{DynamicResource LOCSaveManagerGameMatchingTooltip}"
                    Padding="10,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔗" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource LOCSaveManagerGameMatching}"/>
                </StackPanel>
            </Button>
        </StackPanel>
        
        <!-- 云同步区域 -->
        <Separator Margin="0,20,0,15" Background="{DynamicResource NormalBorderBrush}"/>
        
        <TextBlock Text="{DynamicResource LOCSaveManagerCloudSync}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
        
        <CheckBox Content="{DynamicResource LOCSaveManagerEnableCloudSync}" 
                  IsChecked="{Binding CloudSyncEnabled}"
                  ToolTip="{DynamicResource LOCSaveManagerEnableCloudSyncTooltip}"
                  Margin="0,5,0,5"/>
        
        <CheckBox Content="{DynamicResource LOCSaveManagerSyncConfigOnApplicationStart}"
                  IsChecked="{Binding SyncConfigOnApplicationStart}"
                  ToolTip="{DynamicResource LOCSaveManagerSyncConfigOnApplicationStartTooltip}"
                  Margin="0,0,0,5"/>

        <CheckBox Content="{DynamicResource LOCSaveManagerRestoreOnGameReinstall}"
                  IsChecked="{Binding RestoreOnGameReinstall}"
                  ToolTip="{DynamicResource LOCSaveManagerRestoreOnGameReinstallTooltip}"
                  Margin="0,0,0,5"/>

        <CheckBox Content="{DynamicResource LOCSaveManagerRealtimeSync}"
                  IsChecked="{Binding RealtimeSyncEnabled}" 
                  ToolTip="{DynamicResource LOCSaveManagerRealtimeSyncTooltip}"
                  Margin="0,0,0,5"/>
        
        <CheckBox Content="{DynamicResource LOCSaveManagerSyncConfigOnGameStart}" 
                  IsChecked="{Binding SyncConfigOnGameStart}" 
                  ToolTip="{DynamicResource LOCSaveManagerSyncConfigOnGameStartTooltip}"
                  Margin="0,0,0,10"/>
        
        <!-- 云服务商选择 -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource LOCSaveManagerCloudProvider}" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox SelectedIndex="{Binding CloudProvider}" Width="150"
                      ToolTip="{DynamicResource LOCSaveManagerCloudProviderTooltip}">
                <ComboBoxItem Content="Google Drive"/>
                <ComboBoxItem Content="OneDrive"/>
                <ComboBoxItem Content="WebDAV"/>
                <ComboBoxItem Content="Cloudflare R2"/>
                <ComboBoxItem Content="pCloud"/>
            </ComboBox>
        </StackPanel>
        
        <!-- 配置和验证按钮 -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
            <Button Command="{Binding ConfigureCloudProviderCommand}"
                    ToolTip="{DynamicResource LOCSaveManagerConfigureCloudTooltip}"
                    Padding="10,6" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔧" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource LOCSaveManagerConfigureCloud}"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding VerifyCloudCommand}"
                    ToolTip="{DynamicResource LOCSaveManagerVerifyCloudTooltip}"
                    Padding="10,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔍" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource LOCSaveManagerVerifyCloud}"/>
                </StackPanel>
            </Button>
        </StackPanel>
        
        <!-- 第二行：同步配置 / 验证云端备份 -->
        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
            <Button Command="{Binding SyncConfigNowCommand}"
                    ToolTip="{DynamicResource LOCSaveManagerSyncConfigNowTooltip}"
                    Padding="10,6" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔄" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource LOCSaveManagerSyncConfigNow}"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding VerifyCloudBackupsCommand}"
                    ToolTip="{DynamicResource LOCSaveManagerVerifyCloudBackupsTooltip}"
                    Padding="10,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="✅" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource LOCSaveManagerVerifyCloudBackups}"/>
                </StackPanel>
            </Button>
        </StackPanel>
        
        <!-- 第三行：拉取 / 推送 -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
            <Button Command="{Binding PullAllDataCommand}"
                    ToolTip="{DynamicResource LOCSaveManagerPullAllDataTooltip}"
                    Padding="10,6" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📥" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource LOCSaveManagerPullAllData}"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding PushAllDataCommand}"
                    ToolTip="{DynamicResource LOCSaveManagerPushAllDataTooltip}"
                    Padding="10,6">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📤" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource LOCSaveManagerPushAllData}"/>
                </StackPanel>
            </Button>
        </StackPanel>
        
        <!-- 危险区域 -->
        <Separator Margin="0,30,0,15" Background="{DynamicResource NormalBorderBrush}"/>
        
        <TextBlock Text="{DynamicResource LOCSaveManagerDangerZone}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="#CC0000"/>
        
        <StackPanel Orientation="Horizontal">
            <Button Command="{Binding DeleteAllDataCommand}" 
                    Background="#CC0000" Foreground="White"
                    BorderBrush="#AA0000"
                    Padding="10,6"
                    Margin="0,0,10,0"
                    ToolTip="{DynamicResource LOCSaveManagerDeleteLocalDataTooltip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠️" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource LOCSaveManagerDeleteLocalData}"/>
                </StackPanel>
            </Button>
            <Button Command="{Binding DeleteCloudDataCommand}" 
                    Background="#CC6600" Foreground="White"
                    BorderBrush="#AA5500"
                    Padding="10,6"
                    ToolTip="{DynamicResource LOCSaveManagerDeleteCloudDataTooltip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="☁️" Margin="0,0,6,0"/>
                    <TextBlock Text="{DynamicResource LOCSaveManagerDeleteCloudData}"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
    </ScrollViewer>
</UserControl>
